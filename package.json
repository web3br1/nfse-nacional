{
  "name": "nfse-nacional",
  "version": "0.1.0",
  "description": "Emissor de NFS-e Padrão Nacional: Id, DPS, assinatura, transporte e leitores.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "xsd"
  ],
  "scripts": {
    "gerar-versao": "node scripts/gerar-versao.mjs",
    "prebuild": "npm run gerar-versao",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "pretest": "npm run gerar-versao",
    "test": "vitest run",
    "pretypecheck": "npm run gerar-versao",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "xmllint-wasm": "5.3.0"
  }
}
